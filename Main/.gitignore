# --- Final Project .gitignore ---
# Repo-wide convention from SYNC_GUIDE.md: large data and pickles stay local.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
microns_env/

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# Pickles (per SYNC_GUIDE.md repo policy — large files stay local)
*.pkl
*.pickle

# Heavy data — never committed
data/raw/
data/interim/
data/processed/
data/functional/
data/1718/

# But keep folder structure visible
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/functional/.gitkeep

# Reports — keep markdown, ignore generated figures by default
reports/figures/*.png
reports/figures/*.pdf
reports/figures/*.svg
!reports/figures/.gitkeep

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
